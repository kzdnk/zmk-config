#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {  
  keymap {
    compatible = "zmk,keymap";
    #define base 0
    #define symbols 1
    #define nav 2
    #define bt_layer 3

    default_layer {
      bindings = <
        &kp Q        &kp W       &kp F        &kp P        &kp B  &kp J  &kp L        &kp U        &kp Y       &kp SQT
        &mt LMETA A  &mt LALT R  &mt LCTRL S  &mt LSHFT T  &kp G  &kp M  &mt LSHFT N  &mt LCTRL E  &mt LALT I  &mt LMETA O
        &kp Z        &kp X       &kp C        &kp D        &kp V  &kp K  &kp H        &kp COMMA    &kp DOT     &kp SLASH

        &kp ESC  &kp SPACE   &kp TAB   &lt symbols RETURN  &kp BSPC   &kp DEL 
      >;
      sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
    }; 

    symbols {
      bindings = <
        &kp GRAVE  &kp LT     &kp GT     &kp MINUS  &kp PIPE   &kp CARET  &kp LBRC   &kp RBRC   &kp DOLLAR  &kp SQT
        &kp EXCL   &kp STAR   &kp SLASH  &kp EQUAL  &kp AMPS   &kp UNDER  &kp LPAR   &kp RPAR   &kp SEMI    &kp QMARK
        &kp TILDE  &kp PLUS   &kp LBKT   &kp RBKT   &kp PRCNT  &kp NUHS   &kp COLON  &kp COMMA  &kp DOT     &kp AT

                 &kp LSHFT &kp SPACE &kp LCTRL  &kp RCTRL  &lt bt_layer SPACE  &kp RSHFT 
      >;
      sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
    }; 

    nav {
      bindings = <
        &trans &trans &trans &trans &trans &kp K_REDO    &kp K_PASTE     &kp K_COPY &kp K_CUT   &kp K_UNDO
        &trans &trans &trans &trans &trans &kp LEFT &kp DOWN   &kp UP    &kp RIGHT  &caps_word
        &trans &trans &trans &trans &trans &kp INSERT &kp HOME    &kp PG_DN   &kp PG_UP   &kp END
                    &trans &trans &trans &trans &trans &trans 
      >;
      sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
    }; 

    num {
      bindings = <
        &kp LBKT    &kp N7   &kp N8   &kp N9       &kp RBKT     &trans       &trans    &trans   &trans   &trans
        &kp SEMI    &kp N4   &kp N5   &kp N6       &kp EQUAL    &trans       &trans    &trans   &trans   &trans
        &kp TILDE   &kp N1   &kp N2   &kp N3       &kp SLASH    &trans       &trans    &trans   &trans   &trans
                             &kp DOT  &kp N0       &kp MINUS    &trans       &trans    &trans   
      >;
      sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
    };

    func {
      bindings = <
        &kp F12    &kp F7   &kp F8   &kp F9       &kp RBKT     &trans       &trans    &trans   &trans   &trans
        &kp F11    &kp F4   &kp F5   &kp F6       &kp EQUAL    &trans       &trans    &trans   &trans   &trans
        &kp F10    &kp F1   &kp F2   &kp F3       &kp SLASH    &trans       &trans    &trans   &trans   &trans
                             &trans &trans &trans &trans       &trans    &trans   
      >;
      sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
    };
  };
};
